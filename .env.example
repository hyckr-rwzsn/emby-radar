# ============================================================
#  Emby-Radar 配置模板
#  复制为 .env 并填入真实值：  cp .env.example .env
# ============================================================

# ── 服务器标识（告警时显示，区分多台机器）──
NODE_NAME=My-Node-01

# ── Telegram API 凭证（从 https://my.telegram.org 获取）──
API_ID=
API_HASH=

# ── Bot Token（从 @BotFather 创建）──
ADMIN_BOT_TOKEN=
FORWARD_BOT_TOKEN=
# 可选：多转发 Bot 备用池（逗号分隔）
FORWARD_BOT_TOKENS=
TRUSTED_SENDER_ID=

# ── 频道 / 管理员 ID ──
TARGET_ID=-100xxxxxxxxxx
# 备份频道（可选）：留空则不备份；若填，必须是「私有频道」ID
BACKUP_ID=
OWNER_ID=

# ── 监控阈值（可选，有默认值）──
MAX_RAM_MB=400
MAX_DB_SIZE_MB=50
MAX_LOG_SIZE_MB=5
LOG_BACKUP_COUNT=3
MAX_HISTORY_LINES=3000
LOTTERY_DEDUP_DAYS=10
MAX_LOTTERY_HISTORY=3000
MAX_INTERCEPT_LOG=500
MAX_FORWARD_LOG=500
DB_CLEANUP_DAYS=3
CLEANUP_INTERVAL=3600
MAX_MESSAGE_AGE_SECONDS=1800
# 候选在转发队列中的最长等待秒数（超过丢弃，须大于限流退避常见时长 300~900s）
MAX_QUEUE_DELAY_SECONDS=900
SQLITE_MMAP_MB=32

# ── CPU 看门狗（可选）──
# 只统计「本进程」CPU（不读整机值，避免共享 VPS 被邻居负载误杀）；
# 连续 STRIKES 次 ≥ THRESHOLD 才自愈重启；启动后前 GRACE_SECONDS 秒不计数
CPU_WATCHDOG_INTERVAL=60
CPU_WATCHDOG_THRESHOLD=98
CPU_WATCHDOG_STRIKES=30
CPU_WATCHDOG_GRACE_SECONDS=600
# 重启前最后一道闸：CPU 高**且** STALL_SECONDS 内无转发/拦截记录（业务停滞）才重启
CPU_WATCHDOG_STALL_SECONDS=1800

# ── 限流参数（可选）──
# 账号安全前提下提速：建议先 2.0/10，观察 24 小时无 FloodWait 再上调
RATE_LIMIT_RATE=2.0
RATE_LIMIT_BURST=10

# ── 转发策略（可选）──
# user_native_only：仅主账号原生转发；bot_native：forward_bot 优先 + 主账号兜底（推荐）
FORWARD_MODE=bot_native
ALLOW_BOT_CLONE_FALLBACK=true
ALLOW_USER_NATIVE_FALLBACK=false
ALLOW_PROTECTED_TEXT_CLONE=true
ALLOW_PROTECTED_CLONE=false
ALLOW_MEDIA_CLONE=false
ALLOW_SAFE_MEDIA_CLONE_FALLBACK=true
SEND_PORTAL_MESSAGE=true
MAX_FORWARD_RETRIES=1
BOT_SOURCE_CACHE_TTL=1800
BOT_SOURCE_NEG_TTL=300
MAX_CLONE_MEDIA_MB=4

# ── Telegram 连接参数（可选）──
# TG_MONITOR_DATA_DIR 由 tg-monitor.service 设置，不要放在 .env 里
TG_CONNECT_TIMEOUT=30
TG_STARTUP_TIMEOUT=45
TG_START_RETRIES=3

# ── 测试通道（默认关闭，避免 OWNER 私聊误触发正式转发）──
ENABLE_OWNER_PRIVATE_FORWARD_TEST=false

# ── Telegram 版本号（可选，留空自动检查 GitHub 最新版）──
TG_ANDROID_APP_VERSION=
TG_DESKTOP_APP_VERSION=

# ── 设备轮换（可选，账号安全优先建议 false）──
ENABLE_DEVICE_ROTATION=false
ROTATION_BASE_DAYS=15
ROTATION_JITTER_MIN=-5
ROTATION_JITTER_MAX=5

# ── 心跳 / 看门狗（可选）──
HEARTBEAT_IDLE_HOURS=48
# 推送僵死检测：超过 N 小时未收到任何监控群消息 → 轻量重连
UPDATE_STALENESS_HOURS=4
# 按群静默检测：某群超过 N 小时无消息 → 告警（默认一周，太低会频繁误报）
CHAT_STALE_HOURS=168
# 旧消息拦截：断线重连补收的历史消息，超过 N 小时不再转发
MESSAGE_MAX_AGE_HOURS=12
# 转发来源过旧上限（秒）：上游原始发布时间超过它才拦（默认 24 小时）
FORWARD_ORIGIN_MAX_AGE_SECONDS=86400
# 定期保存 update 状态的间隔秒数（0=关闭），异常退出后从上次位置续传
SAVE_STATE_INTERVAL_SECONDS=300
# 猜码链去重：群友猜的答案是否拦截，false 可关闭回退
GUESS_CHAIN_DEDUP_ENABLED=true
